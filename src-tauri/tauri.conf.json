{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shadow Tracker",
  "version": "6.0.0",
  "identifier": "com.shadowtracker.app",
  "build": {
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Shadow Tracker",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#030603",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Shadow Tracker Software",
    "copyright": "Copyright © 2026 Shadow Tracker Software",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": null,
      "signCommand": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
