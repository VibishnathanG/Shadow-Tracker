<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#030603</item>
        <item name="colorPrimaryDark">#030603</item>
        <item name="colorAccent">#3b82f6</item>
        <item name="android:windowBackground">#030603</item>
        <item name="android:colorBackground">#030603</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#030603</item>
        <item name="android:windowBackground">#030603</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#030603</item>
        <item name="android:windowBackground">#030603</item>
    </style>
</resources>